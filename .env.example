# Copy to .env for local runs. Never commit real values.

# --- Slack -------------------------------------------------------------------
# Leave unset to run in sink mode (writes the exact webhook body to a file).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
SLACK_MODE=auto
SLACK_SINK_PATH=var/slack-sink.jsonl

# --- Deduplication -----------------------------------------------------------
DEDUP_BACKEND=memory
DEDUP_TTL_SECONDS=600
# REDIS_URL=redis://localhost:6379/0

# --- Kubernetes --------------------------------------------------------------
# In a pod this is detected automatically. Locally, KUBECONFIG is honoured.
KUBERNETES_IN_CLUSTER=false

# --- Enrichment --------------------------------------------------------------
LOG_TAIL_LINES=80
MAX_ERROR_LINES=15
ENRICHMENT_BUDGET_SECONDS=4

# --- Links -------------------------------------------------------------------
ALERTMANAGER_URL=https://alertmanager.example.com
GRAFANA_URL=

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
